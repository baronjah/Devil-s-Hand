{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevilsHandStoryboard",
  "type": "object",
  "required": ["story_id", "title", "beats", "timeline"],
  "properties": {
    "story_id": {"type": "string"},
    "title": {"type": "string"},
    "theme_key": {"type": "string"},
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat_id", "story_id", "scene", "timeline_index"],
        "properties": {
          "beat_id": {"type": "string"},
          "story_id": {"type": "string"},
          "scene": {"type": "string"},
          "actors": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}},
          "timeline_index": {"type": "integer"},
          "visual_cue": {"type": "string"},
          "detail_weight": {"type": "number"}
        }
      }
    },
    "timeline": {"type": "array", "items": {"type": "object"}}
  }
}
