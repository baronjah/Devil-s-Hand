{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BasketOutput",
  "type": "object",
  "required": ["prompt_id", "raw_text", "intents", "confidence", "timestamp"],
  "properties": {
    "prompt_id":       {"type": "string"},
    "raw_text":        {"type": "string"},
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fragment", "story_target", "confidence", "type"],
        "properties": {
          "fragment":     {"type": "string"},
          "story_target": {"type": "string"},
          "confidence":   {"type": "number", "minimum": 0, "maximum": 1},
          "type":         {"type": "string", "enum": ["action","branch","question","meta","noise"]}
        }
      }
    },
    "discarded_noise": {"type": "array", "items": {"type": "string"}},
    "confidence":      {"type": "number", "minimum": 0, "maximum": 1},
    "timestamp":       {"type": "string", "format": "date-time"}
  }
}
